{
  "name": "@nodera/react",
  "version": "1.0.0",
  "type": "module",
  "description": "React binding for the Nodera graph editing framework: the React Flow canvas adapter and the React presentation layer, re-exported on top of the framework-agnostic @nodera/sdk.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json --emitDeclarationOnly --declaration --outDir dist/types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "peerDependencies": {
    "@xyflow/react": "^12",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@nodera/react-flow": "workspace:*",
    "@nodera/sdk": "workspace:*",
    "@nodera/ui-react": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@xyflow/react": "^12.12.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^8.5.0",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DannyX1993/nodera.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/types"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
