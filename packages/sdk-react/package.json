    "@nodera/layout-engine": "workspace:*",
    "@nodera/sdk": "workspace:*",
    "@nodera/theme-engine": "workspace:*",
    "@nodera/ui-core": "workspace:*",
    "@nodera/ui-react": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.7.2",
    "vite": "^7.1.0",
    "vitest": "^3.0.5"
