{
  "name": "@nodera/react-flow",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "React Flow integration for Nodera: the canvas adapter that translates the portable graph model to React Flow, plus the SDK binding that composes a builder into a renderable editor.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@nodera/application": "workspace:*",
    "@nodera/contracts": "workspace:*",
    "@nodera/edge-registry": "workspace:*",
    "@nodera/graph-model": "workspace:*",
    "@nodera/node-registry": "workspace:*",
    "@nodera/sdk": "workspace:*",
    "@nodera/ui-core": "workspace:*",
    "@nodera/ui-react": "workspace:*",
    "@xyflow/react": "^12.12.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.7.2",
    "vite": "^7.1.0",
    "vitest": "^3.0.5"
  }
}
