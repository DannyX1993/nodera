{
  "name": "@nodera/react-flow",
  "version": "1.0.0",
  "type": "module",
  "description": "React Flow integration for Nodera: the canvas adapter that translates the portable graph model to React Flow, plus the SDK binding that composes a builder into a renderable editor.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@nodera/application": "workspace:*",
    "@nodera/contracts": "workspace:*",
    "@nodera/edge-registry": "workspace:*",
    "@nodera/graph-model": "workspace:*",
    "@nodera/node-registry": "workspace:*",
    "@nodera/sdk": "workspace:*",
    "@nodera/ui-core": "workspace:*",
    "@nodera/ui-react": "workspace:*",
    "@xyflow/react": "^12.12.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.7.2",
    "vite": "^7.1.0",
    "vitest": "^3.0.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DannyX1993/nodera.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
