{
  "name": "@nodera/sdk",
  "version": "1.0.0",
  "type": "module",
  "description": "Public SDK for the Nodera graph editing framework: builder factory, authoring APIs, registries, document/event/plugin contracts and the engine-agnostic presentation adapter port. No framework dependency.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@nodera/application": "workspace:*",
    "@nodera/contracts": "workspace:*",
    "@nodera/document": "workspace:*",
    "@nodera/domain": "workspace:*",
    "@nodera/edge-registry": "workspace:*",
    "@nodera/graph-layout": "workspace:*",
    "@nodera/graph-model": "workspace:*",
    "@nodera/layout-engine": "workspace:*",
    "@nodera/node-registry": "workspace:*",
    "@nodera/property-system": "workspace:*",
    "@nodera/serialization-json": "workspace:*",
    "@nodera/serialization-yaml": "workspace:*",
    "@nodera/theme-engine": "workspace:*",
    "@nodera/ui-core": "workspace:*",
    "@nodera/validation": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DannyX1993/nodera.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
