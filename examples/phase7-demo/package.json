    "@nodera/plugin-manager": "workspace:*",
    "@nodera/react-flow": "workspace:*",
    "@nodera/sdk": "workspace:*",
    "@xyflow/react": "^12.12.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.7.2",
    "vite": "^7.1.0",
    "vitest": "^3.0.5"
